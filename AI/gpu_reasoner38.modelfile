# 1. Pull directly from your locally installed base model weights
FROM qwen3.8:27b

# 2. Pin resource execution limits natively to your Ryzen 5950X
PARAMETER num_thread 16
PARAMETER num_ctx 16384
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER presence_penalty 1.5

# 3. Bake the persona rules permanently into the model's core system loop

SYSTEM """You are a development box assistant. Keep descriptions compact and write out complete code blocks when requested. /no_think"""
